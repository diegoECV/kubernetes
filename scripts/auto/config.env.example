# =============================================================================
#  config.env — EL ÚNICO ARCHIVO QUE TIENES QUE EDITAR (una sola vez)
#  (se crea con:  cp config.env.example config.env  — config.env NO se sube a git)
# =============================================================================
#  Todo lo demás (IP pública, IP privada, token de kubeadm, endpoint de la RDS,
#  manifiestos de Kubernetes) lo detectan y lo inyectan los scripts solos.
#
#  Regla: valores con caracteres raros (! $ & |) van entre comillas simples '...'
# =============================================================================

# ── Lo que SÍ tienes que poner ───────────────────────────────────────────────
RDS_PASSWORD='CAMBIA_ESTA_CLAVE'     # la misma que pondrás al crear la RDS (mín. 8 caracteres;
                                     # evita / " @ , y espacios porque RDS no los acepta)

# ── Valores por defecto (cámbialos solo si tu proyecto usa otros) ────────────
AWS_REGION="us-east-1"
RDS_IDENTIFIER="visonsdb"            # "DB instance identifier" que usas al crear la RDS
RDS_USER="admin"
RDS_DATABASE="Visons"
MONGO_USER="admin"
MONGO_PASSWORD='admin123'
JWT_SECRET='EsteEsUnSecretoMuyLargoParaJWT2026VisonsSACAutenticacionSegura'
APP_USER="admin@visons.com"          # usuario de prueba para el login (lo crea el seed)
APP_PASSWORD='password123'
NAMESPACE="visons-prod"

# ── Solo para provision-aws.sh (opcional, creación por CLI) ──────────────────
KEY_NAME="vockey"
INSTANCE_TYPE="t3.medium"

# ── OPCIONALES: déjalos vacíos y se autodetectan ─────────────────────────────
PUBLIC_IP=""        # IP pública del master (se lee del metadata de EC2)
RDS_ENDPOINT=""     # endpoint de la RDS (se consulta con aws cli; si no hay permisos te lo pide 1 vez)

# ── Solo provision-aws.sh: de dónde bajan los scripts los nodos ──────────────
REPO_URL="https://github.com/diegoECV/kubernetes.git"
REPO_BRANCH="develop"
RDS_INSTANCE_CLASS="db.t3.small"
